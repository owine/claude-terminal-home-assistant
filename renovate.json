{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>owine/renovate-config",
    "github>owine/renovate-config:automerge",
    "github>owine/renovate-config:python",
    "github>owine/renovate-config:docker",
    "github>owine/renovate-config:alpine",
    "github>owine/renovate-config:node",
    "github>owine/renovate-config:home-assistant"
  ],
  "vulnerabilityAlerts": {
    "groupName": "security updates",
    "labels": ["security"],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Auto-merge Claude Code patch updates from the stable channel",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["custom.claude-code"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "These packages live in the Alpine community repository. Custom datasources use registryStrategy 'first', so this REPLACES the main index rather than adding to it. The URL derives its release line from the depName, so an Alpine bump stays a one-line edit to depNameTemplate. A community package missing from this rule is SILENTLY untracked: no warning, no dashboard entry. See owine/renovate-config README.",
      "matchDatasources": ["custom.alpine"],
      "matchPackageNames": ["/^alpine_.*/(npm|py3-aiohttp|py3-beautifulsoup4|ttyd|vim|yq-go)$/"],
      "registryUrls": ["https://dl-cdn.alpinelinux.org/alpine/v{{ replace '_' '.' (replace 'alpine_' '' (lookup (split packageName '/') 0)) }}/community/x86_64/"]
    }
  ],
  "customManagers": [
    {
      "description": "Update Claude Code version in Dockerfile",
      "customType": "regex",
      "managerFilePatterns": [
        "/^claude-terminal/Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=custom\\.claude-code\\s+ARG\\s+CLAUDE_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "custom.claude-code",
      "depNameTemplate": "claude-code"
    },
    {
      "description": "Update Dockerfile ARG versions with renovate comments",
      "customType": "regex",
      "managerFilePatterns": [
        "/^claude-terminal/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+ARG [A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "description": "Update version pins in shell scripts with renovate comments",
      "customType": "regex",
      "managerFilePatterns": [
        "/^claude-terminal/scripts//"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s+(?:local )?\\w+=\\\"(?<currentValue>[^\\\"]+)\\\""
      ]
    },
    {
      "description": "Update pinned Alpine apk packages via the shared custom.alpine datasource (Alpine CDN index). IMPORTANT: bump alpine version in depNameTemplate when the base image changes (e.g. alpine_3_23 -> alpine_3_24) - it also derives the registry URL",
      "customType": "regex",
      "managerFilePatterns": [
        "/^claude-terminal/Dockerfile$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "\\s\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s+"
      ],
      "versioningTemplate": "loose",
      "datasourceTemplate": "custom.alpine",
      "extractVersionTemplate": "^{{{package}}}-(?<version>\\d.*)\\.apk$",
      "depNameTemplate": "alpine_3_24/{{package}}"
    }
  ],
  "customDatasources": {
    "claude-code": {
      "defaultRegistryUrlTemplate": "https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases/stable",
      "format": "plain"
    }
  }
}
